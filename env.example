# Research Assistant Environment Configuration
# Copy this file to .env and fill in your API keys

# Flask Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
HOST=0.0.0.0
PORT=5050

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Google Gemini Configuration
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2000

# Ollama Configuration (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:latest

# Agent Configuration
MAX_AGENTS_PER_QUERY=5
AGENT_TIMEOUT=300

# Google Search API Configuration (Optional)
# Get these from https://console.cloud.google.com/ and https://cse.google.com/
GOOGLE_SEARCH_API_KEY=your-google-search-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-google-search-engine-id-here

# Research Configuration
MAX_RESEARCH_DEPTH=3
ENABLE_WEB_SEARCH=True
